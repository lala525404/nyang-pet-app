{
  "name": "choeae-app",
  "version": "1.5.0",
  "description": "최애를 풀어놨습니다 - Desktop Buddy App",
  "main": "main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "electron": "electron .",
    "fresh": "npm run build && node scripts/fresh-start.cjs",
    "test": "node scripts/test-default-heart.cjs && node scripts/test-reopen-settings.cjs && node scripts/test-default-light.cjs && node tests/alarms-unit.cjs && node tests/updater-unit.cjs && node tests/login-item-unit.cjs && node tests/focus-mode-unit.cjs && node tests/weather-unit.cjs && node tests/leave-left-unit.cjs",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never",
    "dist:mac": "npm run build && electron-builder --mac --arm64 --publish never",
    "release:meta": "node scripts/fix-update-meta.cjs"
  },
  "build": {
    "appId": "com.choeae.app",
    "productName": "choeae-app",
    "files": [
      "dist/**/*",
      "main.cjs",
      "alarms.cjs",
      "updater.cjs",
      "login-item.cjs",
      "focus-mode.cjs",
      "weather.cjs",
      "preload.cjs",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "afterSign": "scripts/notarize.cjs",
    "publish": [
      {
        "provider": "github",
        "owner": "lala525404",
        "repo": "nyang-pet-app"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "public/icon.icns",
      "hardenedRuntime": true,
      "category": "public.app-category.entertainment",
      "artifactName": "${productName}-${version}-${arch}-mac.${ext}"
    },
    "dmg": {
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "extraResources": [
      {
        "from": "public",
        "to": "public"
      }
    ],
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "최애를 풀어놨습니다",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "artifactName": "choeae-app-Setup-${version}.${ext}"
    }
  },
  "devDependencies": {
    "@electron/notarize": "^2.5.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3",
    "lucide-react": "^1.59.0",
    "pretendard": "^1.3.9",
    "typescript": "^5.5.3",
    "vite": "^5.3.4",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-easy-crop": "^6.2.4",
    "react-router-dom": "^6.24.0"
  }
}
